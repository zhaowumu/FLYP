# Server
PORT=3000

# JWT
JWT_SECRET=generate_with_openssl_rand_-hex_64
JWT_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# 自动备份（默认开启，测试环境可关闭）
# AUTO_BACKUP_ENABLED=false

# DingTalk Webhook
# 在钉钉群聊中添加机器人后获取 webhook 地址
# 格式: https://oapi.dingtalk.com/robot/send?access_token=xxxxx
# 远程备份路径（Windows 共享文件夹，留空则跳过远程备份）
# 例如: \\server\backups\FLYP
REMOTE_BACKUP_PATH=

DINGTALK_WEBHOOK=
