# Server
PORT=3000

# JWT
JWT_SECRET=generate_with_openssl_rand_-hex_64
JWT_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# 自动备份（默认开启，测试环境可关闭）
# AUTO_BACKUP_ENABLED=false

# DingTalk Webhook
# 在钉钉群聊中添加机器人后获取 webhook 地址
# 格式: https://oapi.dingtalk.com/robot/send?access_token=xxxxx
DINGTALK_WEBHOOK=
